# Application Settings
PROJECT_NAME=SignalOS
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=signalos-super-secret-production-jwt-key-2026-secure

# Database Connection (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=signalos
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/signalos

# Redis Cache & Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Queue Engine (options: redis, memory, kafka)
QUEUE_BACKEND=redis

# LLM API Keys (Replace with your actual keys when needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

# Default Models
DEFAULT_LLM_PROVIDER=openai
DEFAULT_FAST_MODEL=gpt-4o-mini
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
